# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다.

# LLM (키가 있어야 LLM 중재를 쓴다. 없으면 결정적 fallback만 사용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max. 선택지 고르기만 하므로 low (API 기본값은 medium)
OPENAI_REASONING_EFFORT=low
LLM_TIMEOUT_S=8

# MQTT (Node 음성·기기 명령. 비워 두면 MQTT 없이 HTTP만)
MQTT_HOST=
MQTT_PORT=1883
# mock: 명령을 보내면 바로 완료로 처리 / mqtt: eyear/v0/device/{device_id}/command로 발행
DEVICE_TRANSPORT=mock

# 판단 기록 (jsonl). 비우면 저장하지 않음
TRACE_PATH=runs/decisions.jsonl
